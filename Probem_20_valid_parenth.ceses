bool isValid(char *s) {
    char st[10000];
    int top = -1;
    for (int i = 0; s[i]; i++) {
        if (s[i] == '(' || s[i] == '[' || s[i] == '{')
            st[++top] = s[i];
        else {
            if (top < 0) return false;
            char x = st[top--];
            if ((s[i] == ')' && x != '(') ||
                (s[i] == ']' && x != '[') ||
                (s[i] == '}' && x != '{'))
                return false;
        }
    }
    return top == -1;
}
